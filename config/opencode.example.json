{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "autoupdate": false,
  "enabled_providers": ["llama.cpp"],
  "server": { "hostname": "127.0.0.1", "port": 4096, "mdns": false },
  "provider": {
    "llama.cpp": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local llama.cpp",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1",
        "apiKey": "{env:LLAMA_API_KEY}"
      },
      "models": {
        "qwen36-main": { "name": "Qwen3.6 35B A3B UD-IQ3_S", "limit": { "context": 65536, "output": 16384 } },
        "qwen3-coder-impl": { "name": "Qwen3 Coder 30B A3B UD-Q4_K_XL", "limit": { "context": 65536, "output": 8192 } }
      }
    }
  },
  "agent": {
    "supervisor": { "description": "Coordinates the bounded workflow", "mode": "all", "maxSteps": 24, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "planner": { "description": "Produces structured plans and acceptance criteria", "mode": "all", "maxSteps": 24, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "test-architect": { "description": "Designs implementation-independent tests", "mode": "all", "maxSteps": 24, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "implementer": { "description": "Implements the approved plan inside the worktree", "mode": "all", "maxSteps": 64, "model": "llama.cpp/qwen3-coder-impl", "tools": { "write": true, "edit": true, "bash": true, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "allow", "bash": "allow", "doom_loop": "deny", "external_directory": "deny" } },
    "focused-implementer": { "description": "Executes one small localized edit with a bounded tool budget", "mode": "all", "maxSteps": 8, "model": "llama.cpp/qwen3-coder-impl", "tools": { "write": true, "edit": true, "bash": true, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "allow", "bash": "allow", "doom_loop": "deny", "external_directory": "deny" } },
    "focused-reviewer": { "description": "Reviews one small localized change with a bounded read-only budget", "mode": "all", "maxSteps": 4, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "focused-repair": { "description": "Repairs one focused review finding with a bounded tool budget", "mode": "all", "maxSteps": 8, "model": "llama.cpp/qwen3-coder-impl", "tools": { "write": true, "edit": true, "bash": true, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "allow", "bash": "allow", "doom_loop": "deny", "external_directory": "deny" } },
    "repository-reviewer": { "description": "Reviews repository correctness independently", "mode": "all", "maxSteps": 8, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "requirements-reviewer": { "description": "Reviews requirements coverage independently", "mode": "all", "maxSteps": 24, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "finding-validator": { "description": "Validates reviewer findings", "mode": "all", "maxSteps": 24, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "repair": { "description": "Repairs validated findings inside the worktree", "mode": "all", "maxSteps": 64, "model": "llama.cpp/qwen3-coder-impl", "tools": { "write": true, "edit": true, "bash": true, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "allow", "bash": "allow", "doom_loop": "deny", "external_directory": "deny" } },
    "adversarial-verifier": { "description": "Challenges the implementation independently", "mode": "all", "maxSteps": 8, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } },
    "final-auditor": { "description": "Performs the final evidence audit", "mode": "all", "maxSteps": 8, "model": "llama.cpp/qwen36-main", "tools": { "write": false, "edit": false, "bash": false, "task": false, "todowrite": false, "webfetch": false, "skill": false }, "permission": { "edit": "deny", "bash": "deny", "doom_loop": "deny", "external_directory": "deny" } }
  },
  "compaction": { "auto": false, "prune": true, "reserved": 10000 }
}
