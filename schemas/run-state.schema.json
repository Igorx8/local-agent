{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "Harness persisted run state",
  "type": "object",
  "required": ["schemaVersion", "runId", "repositoryPath", "artifactPath", "stage", "status", "createdAt", "updatedAt", "counters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "runId": { "type": "string", "minLength": 1 },
    "repositoryPath": { "type": "string", "minLength": 1 },
    "artifactPath": { "type": "string", "minLength": 1 },
    "stage": { "type": "string" },
    "status": { "enum": ["active", "paused", "succeeded", "failed", "escalated"] },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" },
    "counters": {
      "type": "object",
      "required": ["inferenceRetries", "repairIterations", "contextHandoffs"],
      "properties": {
        "inferenceRetries": { "type": "integer", "minimum": 0 },
        "repairIterations": { "type": "integer", "minimum": 0 },
        "contextHandoffs": { "type": "integer", "minimum": 0 }
      }
    },
    "baseline": { "type": "object" },
    "modelManifest": { "type": "string" },
    "acceptanceCriteriaArtifact": { "type": "string" },
    "oracleTestsArtifact": { "type": "string" },
    "historicalMetricsArtifact": { "type": "string" },
    "context": {
      "type": "object",
      "required": ["latestPromptTokens", "contextWindow", "usage", "provenance", "source"],
      "properties": {
        "latestPromptTokens": { "type": "integer", "minimum": 0 },
        "contextWindow": { "type": "integer", "minimum": 1 },
        "usage": { "type": "number", "minimum": 0 },
        "provenance": { "enum": ["exact", "estimated"] },
        "source": { "type": "string" },
        "reason": { "type": "string" },
        "projectedTokens": { "type": "integer", "minimum": 0 },
        "reservedTokens": { "type": "integer", "minimum": 0 },
        "effectiveHandoffThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    },
    "handoffs": { "type": "array", "items": { "type": "object" } },
    "checkpoints": { "type": "array", "items": { "type": "object" } },
    "mutatingActionsBlocked": { "type": "boolean" },
    "manualHandoffRequested": { "type": "boolean" },
    "pausedFromStage": { "type": "string" },
    "activeSession": {
      "type": "object",
      "required": ["role", "sessionId"],
      "properties": { "role": { "type": "string" }, "sessionId": { "type": "string" } },
      "additionalProperties": false
    },
    "activeModel": {
      "type": "object",
      "required": ["role", "alias", "lifecycle"],
      "properties": {
        "role": { "type": "string" },
        "alias": { "type": "string" },
        "lifecycle": { "enum": ["stopped", "loading", "healthy", "generating", "unloading", "error"] },
        "requestDurationMs": { "type": "number", "minimum": 0 },
        "tokensPerSecond": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
