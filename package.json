{
  "name": "local-multi-agent-harness",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "harness": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e:projects": "npm run build && node scripts/e2e-projects.mjs",
    "validate:operational": "npm run build && node scripts/operational-validation.mjs",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@opencode-ai/sdk": "^1.18.25",
    "commander": "^14.0.0",
    "ink": "^7.1.1",
    "pino": "^9.9.0",
    "proper-lockfile": "^4.1.2",
    "react": "^19.2.8",
    "yaml": "^2.8.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.2.14",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
